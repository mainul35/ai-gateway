[Unit]
Description=Deploy new commits of the AI gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# The account that owns the ssh key to homelabai and can run docker
User=proxt
# The pipeline's own clone, made during setup; the script updates itself with each deploy
ExecStart=/home/proxt/gateway-deployer/src/ops/deployer/gateway-deployer.sh
# A deploy waits up to 5 min for homelabai to wake, then builds; give it room
TimeoutStartSec=30min
