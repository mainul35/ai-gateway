# Alternative to Docker: run the wake front straight from a venv on proxy-vm.
#
#   sudo mkdir -p /opt/gateway-wake && sudo cp wake_front.py requirements.txt wake.env /opt/gateway-wake/
#   sudo python3 -m venv /opt/gateway-wake/.venv
#   sudo /opt/gateway-wake/.venv/bin/pip install -r /opt/gateway-wake/requirements.txt
#   sudo cp gateway-wake-front.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now gateway-wake-front
[Unit]
Description=Wake front for the homelabai gateway
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/gateway-wake
EnvironmentFile=/opt/gateway-wake/wake.env
ExecStart=/opt/gateway-wake/.venv/bin/uvicorn wake_front:app --host 0.0.0.0 --port 9100 --workers 1
DynamicUser=yes
Restart=always

[Install]
WantedBy=multi-user.target
