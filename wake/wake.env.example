# Copy to wake.env (git ignores it). Only WAKE_UPSTREAM and WAKE_MAC are required.

# The gateway on homelabai, by LAN address (UFW there must allow 9000 from this machine)
WAKE_UPSTREAM=http://192.168.50.X:9000

# homelabai's NIC (enp3s0) and the LAN's broadcast address
WAKE_MAC=a8:a1:59:9d:f4:ae
WAKE_BROADCAST=192.168.50.255

# Same value as gateway.session.secret in homelabai's config/config.properties. With it, a browser's
# login cookie is checked properly before it may wake the machine; without it, a cookie only gets
# the once-per-cooldown allowance an unknown API key gets.
WAKE_SESSION_SECRET=

# sha256 of gateway.master.key, so the master key always wakes the machine:
#   printf %s "$MASTER_KEY" | sha256sum
WAKE_MASTER_KEY_SHA256=

# How long a non-streamed API request is held while the machine wakes (keep under Cloudflare's 100 s)
WAKE_HOLD_SECONDS=90
# How long a streamed completion waits, sending keep-alive comments
WAKE_STREAM_HOLD_SECONDS=300
# An API key the gateway has not confirmed yet may wake the machine once per this many seconds
WAKE_UNVERIFIED_COOLDOWN=600
