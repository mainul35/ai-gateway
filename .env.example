# Copy to .env and fill in. .env is gitignored: never commit it or put these values anywhere tracked.

# Password for the gateway's PostgreSQL database, used by both compose files. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GATEWAY_DB_PASSWORD=

# Host user that owns config/config.properties, so the gateway container can read it (Linux: id -u / id -g)
GATEWAY_UID=1000
GATEWAY_GID=1000
