#!/bin/sh
# Refuses a push that would add credentials to the remote, or a page whose JavaScript does not parse.
# Enable once per clone:  git config core.hooksPath scripts/git-hooks
PY=python3; command -v python3 >/dev/null 2>&1 || PY=python
TOP=$(git rev-parse --show-toplevel)
"$PY" "$TOP/scripts/check_secrets.py" --pre-push "$@" || exit 1
exec "$PY" "$TOP/scripts/check_page_scripts.py"
